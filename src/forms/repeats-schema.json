{
  "title": "Household and visit",
  "formId": "repeats-0.17.0",
  "formVersionId": "v1",
  "schemaVersion": 2,
  "navigation": { "reviewPage": true, "showProgress": true },
  "drafts": { "mode": "device" },
  "blocks": [
    {
      "id": "p_household",
      "type": "page",
      "title": "Household",
      "blocks": [
        {
          "id": "has_children",
          "type": "choice",
          "label": "Do any children live with you?",
          "required": true,
          "options": ["Yes", "No"]
        },
        {
          "id": "household",
          "type": "group",
          "label": "Your household",
          "blocks": [
            {
              "id": "household_name",
              "type": "short",
              "label": "Household surname",
              "required": true
            },
            {
              "id": "children",
              "type": "group",
              "label": "Children",
              "repeats": true,
              "repeatLabel": "child",
              "minOccurs": 0,
              "maxOccurs": 4,
              "enableWhen": [{ "question": "has_children", "operator": "=", "answer": "Yes" }],
              "blocks": [
                { "id": "child_name", "type": "short", "label": "Child's first name", "required": true },
                { "id": "child_age", "type": "number", "label": "Age", "min": 0, "max": 17 },
                {
                  "id": "child_school",
                  "type": "short",
                  "label": "School",
                  "description": "Shown for this child only when their age is 5 or more (same-instance condition).",
                  "enableWhen": [{ "question": "child_age", "operator": ">=", "answer": 5 }]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p_patients",
      "type": "page",
      "title": "Patients",
      "blocks": [
        {
          "id": "has_insurance",
          "type": "choice",
          "label": "Is the visit covered by insurance?",
          "required": true,
          "options": ["Yes", "No"]
        },
        {
          "id": "patients",
          "type": "group",
          "label": "Patients",
          "repeats": true,
          "repeatLabel": "patient",
          "minOccurs": 1,
          "maxOccurs": 3,
          "blocks": [
            { "id": "patient_name", "type": "short", "label": "Patient name", "required": true },
            { "id": "patient_age", "type": "number", "label": "Patient age", "required": true, "min": 0, "max": 120 },
            {
              "id": "guardian_name",
              "type": "short",
              "label": "Guardian name",
              "required": true,
              "description": "Only for patients under 18 (same-instance condition).",
              "enableWhen": [{ "question": "patient_age", "operator": "<", "answer": 18 }]
            },
            {
              "id": "insurance_number",
              "type": "short",
              "label": "Insurance number",
              "description": "Only when the visit is insured (condition on a question outside any repeat).",
              "enableWhen": [{ "question": "has_insurance", "operator": "=", "answer": "Yes" }]
            },
            {
              "id": "payments",
              "type": "group",
              "label": "Payments",
              "repeats": true,
              "repeatLabel": "payment",
              "minOccurs": 0,
              "blocks": [
                { "id": "payment_amount", "type": "number", "label": "Amount", "required": true, "min": 0 },
                {
                  "id": "payment_method",
                  "type": "choice",
                  "label": "Method",
                  "options": ["Card", "Cash", "Insurance"]
                },
                {
                  "id": "guardian_consent",
                  "type": "choice",
                  "label": "Guardian consents to this payment",
                  "description": "Only when this payment's patient is under 18 (condition on the enclosing instance).",
                  "options": ["Yes", "No"],
                  "enableWhen": [{ "question": "patient_age", "operator": "<", "answer": 18 }]
                },
                {
                  "id": "line_items",
                  "type": "group",
                  "label": "Line items",
                  "repeats": true,
                  "repeatLabel": "line item",
                  "minOccurs": 1,
                  "maxOccurs": 3,
                  "blocks": [
                    { "id": "item_desc", "type": "short", "label": "Description", "required": true },
                    {
                      "id": "item_card_ref",
                      "type": "short",
                      "label": "Card reference",
                      "description": "Only when this payment is by card (one level out).",
                      "enableWhen": [{ "question": "payment_method", "operator": "=", "answer": "Card" }]
                    },
                    {
                      "id": "item_minor_note",
                      "type": "short",
                      "label": "Note for a minor's item",
                      "description": "Only when the patient is under 18 (two levels out).",
                      "enableWhen": [{ "question": "patient_age", "operator": "<", "answer": 18 }]
                    },
                    {
                      "id": "item_policy",
                      "type": "short",
                      "label": "Policy line",
                      "description": "Only when the visit is insured (root question, three levels out).",
                      "enableWhen": [{ "question": "has_insurance", "operator": "=", "answer": "Yes" }]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p_notes",
      "type": "page",
      "title": "Notes",
      "blocks": [
        {
          "id": "notes",
          "type": "group",
          "label": "Notes",
          "repeats": true,
          "repeatLabel": "note",
          "minOccurs": 0,
          "blocks": [{ "id": "note_text", "type": "long", "label": "Note", "required": true }]
        },
        { "id": "final_comment", "type": "long", "label": "Anything else?" }
      ]
    }
  ]
}
