{
  "title": "Clinic visit",
  "formId": "82a94bb8-b03b-4d86-9585-e165900d85b0",
  "formVersionId": "c4d11fdd-9353-470d-b314-75f1bbe8ce8c",
  "schemaVersion": 2,
  "blocks": [
    {
      "id": "p1",
      "type": "page",
      "title": "About you",
      "blocks": [
        {
          "id": "consent",
          "type": "choice",
          "label": "Do you agree to share details?",
          "required": false,
          "options": [
            {
              "code": "yes",
              "label": "Yes"
            },
            {
              "code": "no",
              "label": "No"
            }
          ]
        },
        {
          "id": "hasKids",
          "type": "choice",
          "label": "Do you have children?",
          "required": false,
          "options": [
            {
              "code": "yes",
              "label": "Yes"
            },
            {
              "code": "no",
              "label": "No"
            }
          ]
        }
      ]
    },
    {
      "id": "p2",
      "type": "page",
      "title": "Patients",
      "blocks": [
        {
          "id": "patients",
          "type": "group",
          "label": "Patients",
          "repeats": true,
          "repeatLabel": "patient",
          "minOccurs": 1,
          "maxOccurs": 3,
          "blocks": [
            {
              "id": "pname",
              "type": "short",
              "label": "Patient name",
              "required": false
            },
            {
              "id": "insured",
              "type": "choice",
              "label": "Is this patient insured?",
              "required": false,
              "options": [
                {
                  "code": "yes",
                  "label": "Yes"
                },
                {
                  "code": "no",
                  "label": "No"
                }
              ]
            },
            {
              "id": "payments",
              "type": "group",
              "label": "Payments",
              "repeats": true,
              "repeatLabel": "payment",
              "minOccurs": 0,
              "blocks": [
                {
                  "id": "amount",
                  "type": "number",
                  "label": "Amount",
                  "required": false
                },
                {
                  "id": "items",
                  "type": "group",
                  "label": "Line items",
                  "repeats": true,
                  "repeatLabel": "line item",
                  "minOccurs": 1,
                  "blocks": [
                    {
                      "id": "desc",
                      "type": "short",
                      "label": "Description",
                      "required": false,
                      "enableWhen": [
                        {
                          "question": "consent",
                          "operator": "=",
                          "answer": "yes"
                        }
                      ]
                    },
                    {
                      "id": "cost",
                      "type": "number",
                      "label": "Cost",
                      "required": false,
                      "enableWhen": [
                        {
                          "question": "insured",
                          "operator": "=",
                          "answer": "no"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "refund",
                  "type": "short",
                  "label": "Refund reason",
                  "required": false,
                  "enableWhen": [
                    {
                      "question": "amount",
                      "operator": ">",
                      "answer": 100
                    }
                  ]
                }
              ]
            },
            {
              "id": "pnote",
              "type": "short",
              "label": "Notes about this patient",
              "required": false,
              "enableWhen": [
                {
                  "question": "pname",
                  "operator": "exists"
                }
              ]
            }
          ]
        },
        {
          "id": "followup",
          "type": "short",
          "label": "Follow-up",
          "required": false
        }
      ]
    },
    {
      "id": "p3",
      "type": "page",
      "title": "Household",
      "blocks": [
        {
          "id": "household",
          "type": "group",
          "label": "Household",
          "blocks": [
            {
              "id": "address",
              "type": "short",
              "label": "Address",
              "required": false
            },
            {
              "id": "kids",
              "type": "group",
              "label": "Children",
              "repeats": true,
              "repeatLabel": "child",
              "minOccurs": 0,
              "enableWhen": [
                {
                  "question": "hasKids",
                  "operator": "=",
                  "answer": "yes"
                }
              ],
              "blocks": [
                {
                  "id": "kname",
                  "type": "short",
                  "label": "Child's name",
                  "required": false
                },
                {
                  "id": "kage",
                  "type": "number",
                  "label": "Child's age",
                  "required": false
                },
                {
                  "id": "allergy",
                  "type": "short",
                  "label": "Allergies",
                  "required": false,
                  "enableWhen": [
                    {
                      "question": "kage",
                      "operator": "<",
                      "answer": 5
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "final",
          "type": "short",
          "label": "Anything else?",
          "required": false,
          "enableWhen": [
            {
              "question": "consent",
              "operator": "=",
              "answer": "yes"
            }
          ]
        }
      ]
    }
  ],
  "navigation": {
    "showProgress": true,
    "progressStyle": "caption",
    "reviewPage": false
  }
}
