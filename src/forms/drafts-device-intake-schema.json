{
  "formId": "drafts-device-intake",
  "formVersionId": "drafts-device-intake-v1-coded",
  "title": "Health intake (device drafts)",
  "schemaVersion": 2,
  "navigation": {
    "showProgress": true,
    "reviewPage": true
  },
  "blocks": [
    {
      "id": "pg_about",
      "type": "page",
      "title": "About you",
      "blocks": [
        {
          "id": "name",
          "type": "short",
          "label": "Full name",
          "required": true
        },
        {
          "id": "has_meds",
          "type": "choice",
          "label": "Do you take any regular medication?",
          "options": [
            {
              "code": "yes",
              "label": "Yes"
            },
            {
              "code": "no",
              "label": "No"
            }
          ],
          "required": true
        }
      ]
    },
    {
      "id": "pg_meds",
      "type": "page",
      "title": "Medication",
      "enableWhen": [
        {
          "question": "has_meds",
          "operator": "=",
          "answer": "yes"
        }
      ],
      "blocks": [
        {
          "id": "med_name",
          "type": "short",
          "label": "Medication name",
          "required": true
        },
        {
          "id": "dose_mg",
          "type": "number",
          "label": "Dose (mg)",
          "min": 0,
          "max": 5000
        }
      ]
    },
    {
      "id": "pg_lifestyle",
      "type": "page",
      "title": "Lifestyle",
      "blocks": [
        {
          "id": "smoker",
          "type": "choice",
          "label": "Do you smoke?",
          "options": [
            {
              "code": "yes",
              "label": "Yes"
            },
            {
              "code": "no",
              "label": "No"
            }
          ]
        },
        {
          "id": "g_habits",
          "type": "group",
          "label": "Health habits",
          "blocks": [
            {
              "id": "g_smoking",
              "type": "group",
              "label": "Smoking",
              "enableWhen": [
                {
                  "question": "smoker",
                  "operator": "=",
                  "answer": "yes"
                }
              ],
              "blocks": [
                {
                  "id": "cigs_per_day",
                  "type": "number",
                  "label": "Cigarettes per day",
                  "min": 0,
                  "required": true
                }
              ]
            },
            {
              "id": "activity",
              "type": "dropdown",
              "label": "How active are you?",
              "options": [
                {
                  "code": "not_very",
                  "label": "Not very"
                },
                {
                  "code": "somewhat",
                  "label": "Somewhat"
                },
                {
                  "code": "very",
                  "label": "Very"
                }
              ]
            }
          ]
        },
        {
          "id": "followup",
          "type": "choice",
          "label": "Would you like a follow-up call?",
          "options": [
            {
              "code": "yes",
              "label": "Yes"
            },
            {
              "code": "no",
              "label": "No"
            }
          ]
        }
      ]
    },
    {
      "id": "pg_followup",
      "type": "page",
      "title": "Follow-up",
      "blocks": [
        {
          "id": "phone",
          "type": "phone",
          "label": "Phone number",
          "required": true,
          "enableWhen": [
            {
              "question": "followup",
              "operator": "=",
              "answer": "yes"
            }
          ]
        },
        {
          "id": "best_time",
          "type": "dropdown",
          "label": "Best time to call",
          "options": [
            {
              "code": "morning",
              "label": "Morning"
            },
            {
              "code": "afternoon",
              "label": "Afternoon"
            },
            {
              "code": "evening",
              "label": "Evening"
            }
          ],
          "enableWhen": [
            {
              "question": "followup",
              "operator": "=",
              "answer": "yes"
            }
          ]
        }
      ]
    }
  ],
  "drafts": {
    "mode": "device"
  }
}
