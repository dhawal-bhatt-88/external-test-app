# Every text file is LF in the index and on disk, on every machine,
# so `npm pack` gives the same bytes from the same commit.
* text=auto eol=lf

# Binary: never convert line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.wav   binary
*.mp3   binary
*.mp4   binary
*.webm  binary
*.tgz   binary
*.gz    binary
*.zip   binary
*.pdf   binary
